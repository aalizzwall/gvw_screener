# ============================================================
# GVW Screener Environment Variables Template (.env.example)
# ============================================================
# 複製此檔案為 .env 並填入相應的金鑰與設定：
#   cp .env.example .env

# --- Telegram Bot 設定 ---
# 從 @BotFather 取得的 Bot Token
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# 預設推播頻道/群組 Chat ID (例如: -1001234567890)
TELEGRAM_HOME_CHANNEL=""

# 系統負責人 Telegram User ID (可向 @userinfobot 查詢)
TELEGRAM_OWNER_USER_ID=""

# --- 市場資料來源憑證 ---
# FinMind API Token (免費註冊於 https://finmind.github.io/)
FINMIND_TOKEN=""

# --- AI 分析師：第一優先雲端模型 (OpenAI) ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- AI 分析師：第二備援雲端模型 (Google AI Studio / Gemma) ---
# 可在 https://aistudio.google.com/ 取得免費 API Key
GEMINI_API_KEY=""
GEMMA_MODEL="gemma-3-27b-it"

# --- AI 分析師：第三地端保底模型 (LM-Studio / LocalAI on LAN) ---
# 本機或區網電腦執行的 LM-Studio OpenAI 相容端點
LOCAL_AI_BASE_URL="http://localhost:1234/v1"
LOCAL_AI_API_KEY="lm-studio"
LOCAL_AI_MODEL="active"

# --- 自訂目錄路徑 (選填，預設為專案目錄) ---
# GVW_HOME="/home/pi/.hermes/gvw_screener"
# GVW_DATA_DIR="/home/pi/.hermes/gvw_screener/data"
