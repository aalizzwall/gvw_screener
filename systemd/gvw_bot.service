[Unit]
Description=GVW Telegram Bot
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.hermes/gvw_screener/gvw_bot
EnvironmentFile=-%h/.hermes/gvw_screener/.env
ExecStart=%h/.hermes/gvw_screener/.venv/bin/python %h/.hermes/gvw_screener/gvw_bot/main.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
